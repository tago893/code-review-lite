diff --git a/app/services/hold_service.py b/app/services/hold_service.py
index 98ed44f..009a62a 100644
--- a/app/services/hold_service.py
+++ b/app/services/hold_service.py
@@ -88,11 +88,18 @@ class HoldService:
         return hold
 
     def get_hold(self, hold_id: str) -> Hold | None:
-        """Return the live hold, or None if it is unknown, finished or expired."""
+        """Return the hold, or None if it is unknown or no longer active.
+
+        Falls back to the durable record when the cache entry is missing, so a
+        cache restart does not strand customers who are mid-checkout.
+        """
         raw = self._kv.get(f"hold:{hold_id}")
-        if raw is None:
-            return None
-        return _hold_from_json(raw)
+        if raw is not None:
+            return _hold_from_json(raw)
+        stored = self._holds.get(hold_id)
+        if stored is not None and stored.status is HoldStatus.ACTIVE:
+            return stored
+        return None
 
     def view_hold(self, principal: Principal, hold_id: str) -> Hold:
         hold = self._require_active(hold_id)
diff --git a/tests/test_hold_durability.py b/tests/test_hold_durability.py
new file mode 100644
index 0000000..7632e86
--- /dev/null
+++ b/tests/test_hold_durability.py
@@ -0,0 +1,35 @@
+from __future__ import annotations
+
+
+def _confirm(client, headers, hold_id, key="key-1"):
+    return client.post(
+        "/bookings", json={"hold_id": hold_id}, headers={**headers, "Idempotency-Key": key}
+    )
+
+
+def test_hold_is_still_visible_after_cache_flush(client, event, kv, as_user, make_hold):
+    alice = as_user("alice")
+    hold = make_hold(alice, event).json()
+    kv.flush()
+    resp = client.get(f"/holds/{hold['id']}", headers=alice)
+    assert resp.status_code == 200
+    assert resp.json()["id"] == hold["id"]
+
+
+def test_booking_can_be_confirmed_after_cache_flush(client, event, kv, as_user, make_hold):
+    alice = as_user("alice")
+    hold = make_hold(alice, event).json()
+    kv.flush()
+    assert _confirm(client, alice, hold["id"]).status_code == 201
+
+
+def test_released_hold_stays_gone_after_cache_flush(client, event, kv, as_user, make_hold):
+    alice = as_user("alice")
+    hold = make_hold(alice, event).json()
+    client.delete(f"/holds/{hold['id']}", headers=alice)
+    kv.flush()
+    assert client.get(f"/holds/{hold['id']}", headers=alice).status_code == 410
+
+
+def test_unknown_hold_is_still_gone(client, as_user):
+    assert client.get("/holds/missing", headers=as_user("alice")).status_code == 410
